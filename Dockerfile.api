FROM node:20-bullseye
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Root deps for tools/*
COPY package*.json ./
RUN (npm ci --omit=dev || npm install --omit=dev)

# API deps
COPY backend/server/package*.json ./backend/server/
RUN bash -lc 'cd backend/server && (npm ci --omit=dev || npm install --omit=dev)'

# Rest of repo
COPY . .

ENV NODE_ENV=production
CMD ["node", "backend/server/server.js"]
