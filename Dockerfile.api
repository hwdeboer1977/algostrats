FROM node:20-bullseye

# Install Python and Yarn
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    corepack enable && \
    corepack prepare yarn@stable --activate

WORKDIR /app

# Copy package manifests first
COPY backend/server/package*.json          ./backend/server/
COPY tools/bridge/package*.json            ./tools/bridge/
COPY tools/drift/package.json tools/drift/yarn.lock  ./tools/drift/
COPY tools/swap/package*.json              ./tools/swap/

# Copy Python requirements BEFORE installing
COPY tools/hyperliquid/requirements.txt    ./tools/hyperliquid/requirements.txt

# Install Node.js dependencies
RUN cd backend/server && (npm ci --omit=dev || npm install --omit=dev)
RUN cd tools/bridge && (npm ci --omit=dev || npm install --omit=dev)
RUN cd tools/drift && yarn install --mode skip-build
RUN cd tools/swap && (npm ci --omit=dev || npm install --omit=dev)

# Install Python dependencies
RUN pip3 install --no-cache-dir -r tools/hyperliquid/requirements.txt

# Copy the rest of the repo
COPY . .

# Create startup script that generates config.json from environment variables
# Create startup script that generates config.json from environment variables
RUN echo '#!/bin/bash\n\
echo "=== Entrypoint script starting ==="\n\
echo "HYPERLIQUID_SECRET_KEY present: $([ -n "$HYPERLIQUID_SECRET_KEY" ] && echo YES || echo NO)"\n\
if [ -n "$HYPERLIQUID_SECRET_KEY" ]; then\n\
  mkdir -p /app/tools/hyperliquid\n\
  cat > /app/tools/hyperliquid/config.json <<EOF\n\
{\n\
  "secret_key": "$HYPERLIQUID_SECRET_KEY",\n\
  "account_address": "$HYPERLIQUID_ACCOUNT_ADDRESS",\n\
  "ARBITRUM_ALCHEMY_MAINNET": "$ARBITRUM_ALCHEMY_MAINNET",\n\
  "WALLET_SOLANA_SECRET": "$WALLET_SOLANA_SECRET",\n\
  "SOLANA_PUBKEY": "$SOLANA_PUBKEY",\n\
  "SOLANA_RPC": "$SOLANA_RPC"\n\
}\n\
EOF\n\
  echo "Generated config.json successfully"\n\
  ls -la /app/tools/hyperliquid/config.json\n\
else\n\
  echo "WARNING: HYPERLIQUID_SECRET_KEY not found in environment!"\n\
fi\n\
exec "$@"' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

ENV NODE_ENV=production
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["node", "backend/server/server.js"]