FROM node:20-bullseye

# Install Python
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy root package.json first (if exists)
COPY package*.json ./
RUN npm ci --omit=dev || npm install --omit=dev

# Copy keeper package.json
COPY backend/keeper/package*.json ./backend/keeper/
RUN cd backend/keeper && (npm ci --omit=dev || npm install --omit=dev)

# Copy the rest of the repo
COPY . .

ENV NODE_ENV=production
CMD ["node", "backend/keeper/index.js"]